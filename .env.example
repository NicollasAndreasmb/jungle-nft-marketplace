# Ativa a camada de mocks (MSW REST + Socket.IO). Obrigatório para a demonstração.
VITE_ENABLE_MOCKS=true
# Base das chamadas REST (Axios). Com mocks, os handlers MSW respondem nesta origem.
VITE_API_BASE_URL=/api
# Endereço do servidor Socket.IO. Com mocks, a conexão WebSocket é interceptada pelo MSW.
VITE_SOCKET_URL=wss://realtime.jungle.mock
